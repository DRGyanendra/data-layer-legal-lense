# Copy to .env and fill in. Never commit .env.

# Qdrant Cloud: cluster URL and API key from the Qdrant dashboard
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=judgment_chunks

# Neo4j Aura: the neo4j+s:// URI and the password shown once at creation
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Embedding model. The backend must embed queries with the same model.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Supabase Postgres connection string. Optional here: the backend owns those tables.
DATABASE_URL=
